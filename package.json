{
  "name": "stackreplay",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Replay your real AI coding workload against other execution targets.",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:contrast": "node tooling/scripts/check-contrast.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  }
}
