{
  "name": "@stackreplay/replay-engine",
  "version": "0.0.4",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Pure deterministic replay simulation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "pnpm build && node bench/replay-100k.mjs",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@stackreplay/catalog": "workspace:*",
    "@stackreplay/schema": "workspace:*",
    "decimal.js": "^10.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stackreplay/config": "workspace:*",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
