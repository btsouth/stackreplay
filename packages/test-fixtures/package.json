{
  "name": "@stackreplay/test-fixtures",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Deterministic demo fixtures for design, development and testing. No real user data.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./demo-scenario": {
      "types": "./src/demo-scenario.ts",
      "default": "./src/demo-scenario.ts"
    },
    "./generated/m4d-demo.json": "./generated/m4d-demo.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "pnpm --filter @stackreplay/replay-engine build && node ../../apps/web/scripts/build-demo-artifact.mjs",
    "clean": "rm -rf .turbo"
  },
  "devDependencies": {
    "@stackreplay/config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@stackreplay/schema": "workspace:*"
  }
}
