{
  "name": "@stackreplay/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The stackreplay CLI: local detection, scanning, export and local replay.",
  "type": "module",
  "bin": {
    "stackreplay": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@stackreplay/config": "workspace:*",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
