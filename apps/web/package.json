{
  "name": "@stackreplay/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "StackReplay web application.",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev",
    "build": "node scripts/build-worker.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .turbo test-results playwright-report",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@stackreplay/catalog": "workspace:*",
    "@stackreplay/replay-engine": "workspace:*",
    "@stackreplay/schema": "workspace:*",
    "@stackreplay/test-fixtures": "workspace:*",
    "@stackreplay/ui": "workspace:*",
    "geist": "^1.7.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stackreplay/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
